# Copy this file to secrets/nextcloud.env and fill in your own values.
# secrets/nextcloud.env is gitignored and must NEVER be committed.
#
# Parsed as plain KEY=VALUE data (see src/calendar_sync/credentials.py) -
# never sourced or executed as shell code, so it is safe even if a value
# contains shell metacharacters.

NEXTCLOUD_USERNAME=your-nextcloud-username

# Use a Nextcloud "app password", NOT your real login password:
# Nextcloud web UI -> Settings -> Security -> "Create new app password".
# That way you can revoke it any time without changing your main
# password, and it keeps working even if you have two-factor
# authentication enabled.
NEXTCLOUD_APP_PASSWORD=your-app-password
